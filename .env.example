# Backend environment template. Copy to the repository-root .env.local.
# Neon CLI may also populate .env.local for the selected branch.
DATABASE_URL=
# Direct (non-pooled) connection: used by migrations and the server tests.
DATABASE_URL_UNPOOLED=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=assets
PORT=3000
# Proxies in front of the API, so sign-in limits count each visitor, not the proxy.
# Leave 0 locally; use 2 on Render behind the Vercel /api rewrite.
TRUST_PROXY=0

# Browser origins allowed to call the API (comma separated).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Login session length in days, and bcrypt cost (12 is a good production value).
SESSION_DAYS=7
BCRYPT_COST=12

# Unlisted address of the administrator sign-in page; it is not linked anywhere on the website.
# Choose something hard to guess, e.g. /staff-7f3k9q. Empty = administrator sign-in is off.
# Write only the path, never the whole link: in this file "#" starts a comment, so
# "http://localhost:5173/Doctor-platform/#/staff-7f3k9q" would be cut off at the "#".
# The website reads only this one key from this file. It hides the page from casual visitors, not
# from a determined one (it ends up in the browser bundle); the server still checks the role and
# throttles sign-in attempts.
VITE_ADMIN_LOGIN_PATH=

# First administrator, created by `npm run seed` in server/ (password: at least 10 characters).
SEED_ADMIN_EMAIL=admin@carewell.test
SEED_ADMIN_PASSWORD=

# Outgoing email. Leave SMTP_HOST empty in development to print emails to the server console.
# Gmail: turn on 2-Step Verification and create an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Carewell <you@example.com>"
# Where messages from the help page are emailed. Optional: defaults to SMTP_USER.
SUPPORT_EMAIL=
# Public address of the website; used for the reset-password link inside emails.
APP_URL=http://127.0.0.1:5173/Doctor-platform/

# Optional: password of the demo doctors and patients created by `npm run seed:demo` (10+ characters).
SEED_DEMO_PASSWORD=
